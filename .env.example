# -------- LLM / Gemini (compulsory unless you disable USE_LLM) --------
USE_LLM=true                               # compulsory – enable the tool-augmented agent
LLM_PROVIDER=gemini                        # compulsory – provider slug the server expects
GEMINI_API_KEY=__REPLACE_WITH_GEMINI_KEY__ # compulsory – create via Google AI Studio / Vertex
GEMINI_MODEL=models/gemini-2.5-pro         # optional – override default Gemini model id
LLM_MAX_TOKENS=2048                        # optional – maximum tokens per response
LLM_TEMPERATURE=0.3                        # optional – keep low for structured outputs

# -------- Knowledge / Vector Store (required for RAG answers) --------
CHROMA_URL=http://chroma:8000              # compulsory – HTTP endpoint for Chroma
CHROMA_COLLECTION=knowledge_specter        # compulsory – knowledge collection name
CHROMA_COLLECTION_PROFILES=profiles_specter# compulsory – profile embeddings collection
CHROMA_SKIP_INDEX=0                        # optional – set to 1 to start without auto-indexing

# -------- AWS Telemetry Mirror + Report Upload (compulsory) --------
AWS_S3_BUCKET=__REPLACE_WITH_BUCKET__      # compulsory – bucket containing CSV telemetry
AWS_S3_REGION=eu-west-2                    # compulsory – bucket region
AWS_S3_PREFIX=digispace_backup_24_10_2025  # compulsory – prefix/folder for this environment
AWS_ACCESS_KEY_ID=__REPLACE_WITH_ACCESS_KEY__     # compulsory – IAM user or assumed role key
AWS_SECRET_ACCESS_KEY=__REPLACE_WITH_SECRET_KEY__ # compulsory – matching secret
AWS_SESSION_TOKEN=                         # optional – include when using temporary credentials
S3_LOCAL_DIR=CSVex_s3                      # optional – local mirror directory
AWS_S3_FORCE_PATH_STYLE=0                  # optional – set 1 for MinIO/localstack style endpoints
S3_MIRROR_ON_START=1                       # optional – auto-sync on server boot

# -------- Neo4j Aura (compulsory) --------
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io  # compulsory – Aura connection string
NEO4J_USERNAME=neo4j                         # compulsory – Aura username
NEO4J_PASSWORD=__REPLACE_WITH_NEO4J_PASSWORD__        # compulsory – Aura password
NEO4J_DATABASE=neo4j                         # optional – Aura default database name
NEO4J_SKIP_POPULATE=1                        # optional – keep 1 to avoid overwriting prod data
NEO4J_SKIP_CHECK=0                           # optional – enable if Aura health check should be skipped
NEO4J_ALLOW_FALLBACK=1                       # optional – let app run in read-only/degraded mode
NEO4J_ALLOW_DEGRADED=0                       # optional – legacy alias, keep 0 unless needed
NEO4J_WAIT_ATTEMPTS=180                      # optional – startup wait cycles for Aura connectivity

# -------- Reranker / Python bridge (optional) --------
RERANK_ENABLED=1                            # optional – set 0 to disable reranker when Python absent
RERANK_TOP=20                               # optional – number of documents to rerank
RERANK_PYTHON_BIN=python3                   # optional – explicit python executable for Windows
PYTHON_BIN=python3                          # optional – fallback python path for scripts

# -------- Weather backfill (optional) --------
WEATHER_PROVIDER=openweather               # optional – currently supports openweather only
OPENWEATHER_API_KEY=__REPLACE_WITH_OPENWEATHER_KEY__ # optional – needed for live weather calls
WEATHER_DEFAULT_LAT=53.576                  # optional – fallback latitude if scope missing geo
WEATHER_DEFAULT_LON=-2.429                  # optional – fallback longitude
WEATHER_USE_SYNTHETIC=0                     # optional – set 1 to force synthetic weather data

# -------- Logging / Debug (optional) --------
LOG_LEVEL=info                              # optional – info | debug
HTTP_DEBUG=0                                # optional – 1 to log every HTTP request
RAG_DEBUG=0                                 # optional – 1 to log agent internals
LLM_DEBUG=0                                 # optional – 1 for verbose LLM traces
TRACE_DIR=                                   # optional – custom directory for agent traces

# -------- Server Options (optional) --------
PORT=3000                                   # optional – API port
AGENT_MAX_ATTEMPTS=2                        # optional – retries when chart missing

# -------- Test / Pipeline (optional) --------
TEST_BASE_URL=http://localhost:3000         # optional – pipeline override for API base URL
TEST_RESULTS_DIR=data/tests                 # optional – folder for pipeline artifacts
TEST_REF_DATE=2025-10-24T23:59:00.000Z      # optional – reference timestamp for scripted tests
TEST_SCENARIO_COUNT=30                      # optional – limit chat scenarios executed

# -------- Legacy CSV utilities (optional) --------
CSV_DIR=CSVex_s3                            # optional – legacy import scripts

