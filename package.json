{
  "name": "avmsolutions-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "check:neo4j": "node scripts/check_neo4j.js",
    "populate:neo4j": "node scripts/populate_neo4j.js",
    "import:csv": "node scripts/import_csv.js",
    "import:weather": "node scripts/openweather_import.js",
    "enrich:csv": "node scripts/enrich_csvs.js",
    "docker:up": "docker build -t avmsolutions-analytics . && docker run -d --name avmsolutions-analytics -p 3000:3000 --env-file .env avmsolutions-analytics",
    "docker:down": "docker stop avmsolutions-analytics && docker rm avmsolutions-analytics",
    "docker:logs": "docker logs -f avmsolutions-analytics",
    "index:chroma": "python3 scripts/index_chroma.py"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "neo4j-driver": "^5.22.0"
  }
}
